                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.microsoft\\.VSCode$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "description": "Excluded apps: left_command + Shift + S",
                                "from": {
                                    "key_code": "s",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_shift"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [{ "shell_command": "/usr/sbin/screencapture -i -c" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.apple\\.Terminal$",
