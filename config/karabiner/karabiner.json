                                "description": "Non-excluded apps: left_control + Shift + S",
                                "from": {
                                    "key_code": "s",
                                    "modifiers": {
                                        "mandatory": ["left_control", "left_shift"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [{ "shell_command": "/usr/sbin/screencapture -i -c" }],
                                "type": "basic"
                            }
                        ]
