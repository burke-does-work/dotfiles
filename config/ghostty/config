font-family = CommitMono Nerd Font
font-feature = calt
font-size = 13

theme = Gruvbox Dark Hard
palette = 0=#504945
selection-background = #d65d0e
selection-foreground = #1d2021

confirm-close-surface = false

window-padding-x = 16
window-padding-y = 12

macos-titlebar-style = tabs

unfocused-split-fill = #252628

# Clipboard
keybind = ctrl+shift+p=paste_from_clipboard
keybind = ctrl+shift+y=copy_to_clipboard
copy-on-select = clipboard

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+r=prompt_tab_title

# Unbind default Cmd+N tab selection
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind

# Direct tab access
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=last_tab

# Splits
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+b=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+left=resize_split:left,20
keybind = ctrl+shift+right=resize_split:right,20
keybind = ctrl+shift+up=resize_split:up,20
keybind = ctrl+shift+down=resize_split:down,20
keybind = ctrl+shift+zero=equalize_splits
