      "WebFetch(*)",
      "WebSearch(*)",
      "Read(**)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(awk *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(man *)",
      "Bash(jq *)",
      "Bash(tree *)",
      "Bash(column *)",
      "Bash(nl *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(printf *)",
      "Bash(date)",
      "Bash(whoami)",
      "Bash(id)",
      "Bash(hostname)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git stash list*)",
      "Bash(ps *)",
      "Bash(uname *)",
      "Bash(sw_vers)",
      "Bash(launchctl list *)",
      "Bash(log show *)",
      "Bash(diskutil list)",
      "Bash(htop)",
      "Bash(ldd *)",
      "Bash(docker ps)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker compose ps*)",
      "Bash(docker version)",
      "Bash(docker info)",
      "Bash(gh pr list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list*)",
      "Bash(gh run view *)",
      "Bash(gh auth status)",
      "Bash(pip list)",
      "Bash(pip show *)",
      "Bash(pip freeze)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(brew search *)",
      "Bash(brew outdated)",
      "Bash(npm list *)",
      "Bash(npm outdated *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(uv venv *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv lock)",
      "Bash(uv lock *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv run *)",
      "Bash(uv init *)",
      "Bash(uv build *)",
      "Bash(uv export *)",
      "Bash(uv --version)",
      "Bash(uv tree*)",
      "Bash(uv python list*)",
      "Bash(uv python find*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(claude *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(ghostty *)",
      "Bash(yazi *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(uv pip install *)",
      "Bash(python3 -m pip *)",
      "Bash(gh extension install *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Read(//Users/matt/.ssh/**)",
      "Read(//Users/matt/.gnupg/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh release delete*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api -XDELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api --method=DELETE*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git push origin :*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune=now*)"
    ],
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      "/Users/matt/local/documents",
      "/Users/matt/local/dotfiles"
    ],
    "_comment": "Working scope is documents/ and dotfiles/. Manual mode grants no writes -- filesystem mutation (mkdir, cp, mv, touch, chmod, ln, sed, rm) is deliberately absent from allow so that acceptEdits grants it, scoped to the two trees above. Anything outside them prompts. See dotfiles/docs/claude-permissions.md.",
    "_comment_ask": "Ask overrides the permission mode, so these prompt even in acceptEdits. rm/rmdir are here because acceptEdits would otherwise auto-approve them across the whole working scope.",
    "_comment_deny": "Reads: SSH+GPG keys, .env files (1Password holds API keys; .env blocked as a safety net). Note the // prefix -- a single leading slash anchors at the settings source, not the filesystem root. Commands: irreversible GitHub and git history operations. A deny rule matches command text, not the program, so it narrows accidents rather than forming a boundary."
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "agentPushNotifEnabled": false,
  "model": "opus"
}
