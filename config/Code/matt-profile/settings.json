{

  //////////////////////////////////////////////////////////////////////////////
  // VS Code behavior
  //////////////////////////////////////////////////////////////////////////////

  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Gruvbox Dark Hard",
  "update.showReleaseNotes": false,
  "update.mode": "none",
  "window.newWindowProfile": "matt",
  "application.shellEnvironmentResolutionTimeout": 60,
  "files.autoSave": "onFocusChange",
  "workbench.editor.labelFormat": "short",

  //////////////////////////////////////////////////////////////////////////////
  // Basic functionality
  //////////////////////////////////////////////////////////////////////////////

  "explorer.confirmPasteNative": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "workbench.editor.doubleClickTabToToggleEditorGroupSizes": "maximize",

  //////////////////////////////////////////////////////////////////////////////
  // Autocomplete & editor
  //////////////////////////////////////////////////////////////////////////////

  "editor.inlineSuggest.enabled": false,  // disabled — inline AI suggestions are distracting
  "editor.parameterHints.enabled": false,
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never",

  // Pylance
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.inlayHints.variableTypes": false,
  "python.analysis.inlayHints.functionReturnTypes": false,
  "python.analysis.inlayHints.callArgumentNames": "off",
  "python.analysis.inlayHints.pytestParameters": false,

  //////////////////////////////////////////////////////////////////////////////
  // Tab completion
  // NOTE: VSCodeVim intercepts Tab in insert mode for snippet expansion — verify
  // that tab completion works as expected. Add vim.handleKeys for <tab> if needed.
  // Return to this when reviewing tab completion in setup notes.
  //////////////////////////////////////////////////////////////////////////////

  "editor.acceptSuggestionOnEnter": "off",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.tabCompletion": "on",
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },

  //////////////////////////////////////////////////////////////////////////////
  // Markdown
  //////////////////////////////////////////////////////////////////////////////

  "markdown.validate.enabled": true,
  "markdown.validate.referenceLinks.enabled": "ignore",

  // Archived - Markdown linter no longer used
  // markdownlint now runs from the CLI per repo, configured in
  // .markdownlint-cli2.jsonc. The extension is not installed.

  "markdownlint.config": {
    "default": true,
    "MD033": false, // no inline HTML
    "MD045": false, // images require alt text
    "MD036": false, // no emphasis as headings
    "MD024": false // no duplicate heading text
  },

  // Prettier is the formatter for every type it supports, matching the CLI in
  // each repo's ## Verify command. The per-language blocks below name it
  // explicitly rather than setting it globally, so Python stays with ruff and
  // types Prettier cannot parse are left alone. markdown-all-in-one stays
  // installed for its table of contents, list continuation and shortcuts, but
  // no longer formats. requireConfig keeps Prettier inert in repos with no
  // .prettierrc.

  "prettier.requireConfig": true,

  "[markdown]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
"editor.tokenColorCustomizations": {
    "textMateRules": [
        {
            "scope": "heading.1.markdown entity.name.section.markdown",
            "settings": {
                "foreground": "#928374",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": {
                "foreground": "#8ec07c",
                "fontStyle": "bold"
            }
        },
    ]
},

  //////////////////////////////////////////////////////////////////////////////
  // Formatting
  //////////////////////////////////////////////////////////////////////////////

  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  // Ruff is the Python formatter and linter, matching the ruff block each
  // project carries in pyproject.toml. Replaces Black.

  "[python]": {
    "editor.codeLens": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.indentSize": 4,
    "editor.detectIndentation": false,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  
  //////////////////////////////////////////////////////////////////////////////
  // Appearance
  //////////////////////////////////////////////////////////////////////////////

  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.rulers": [88],
  "editor.minimap.enabled": false,
  "editor.cursorSurroundingLines": 8,

  //////////////////////////////////////////////////////////////////////////////
  // VIM
  //////////////////////////////////////////////////////////////////////////////

  "vim.leader": " ",
  "vim.useSystemClipboard": true,
  "vim.cursorStylePerMode.normal": "block",
  "vim.cursorStylePerMode.insert": "line",
  "vim.cursorStylePerMode.visual": "block-outline",
  "vim.cursorStylePerMode.replace": "underline",
  //////////////////////////////////////////////////////////////////////////////
  // Git
  //////////////////////////////////////////////////////////////////////////////

  "git.autofetch": true,
  "git.countBadge": "off",
  "git.rebaseWhenSync": true,
  "git.openRepositoryInParentFolders": "never",
  "git.showActionButton": {
    "commit": false,
    "publish": false,
    "sync": false
  },
  "githubPullRequests.quickDiff": true,

  //////////////////////////////////////////////////////////////////////////////
  // Jupyter
  //////////////////////////////////////////////////////////////////////////////

  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "jupyter.askForKernelRestart": false,
  "jupyter.interactiveWindow.codeLens.commands": "",
  "jupyter.interactiveWindow.cellMarker.decorateCells": "allCells",
  "interactiveWindow.collapseCellInputCode": "never",

  //////////////////////////////////////////////////////////////////////////////
  // Inline fold (markdown)
  // Folds the URL in markdown links [link text](url), leaving only the link
  // text visible while editing. Reduces visual noise in markdown files.
  //////////////////////////////////////////////////////////////////////////////

  // "inlineFold.regex": "\\[([^\\]]*)\\]\\(([^\\s]+)\\)[^\\)\\s]*\\s",
  // "inlineFold.regexFlags": "g",
  // "inlineFold.regexGroup": 2,
  // "inlineFold.supportedLanguages": [
  //   "markdown"
  // ],

  //////////////////////////////////////////////////////////////////////////////
  // Spell check
  //////////////////////////////////////////////////////////////////////////////

  "cSpell.userWords": [
    "Adjacents",
    "Benchdogs",
    "Bessey",
    "Boeshield",
    "Computering",
    "datasheet",
    "Festool",
    "Makita",
    "negotiables",
    "Outdoorsing",
    "Panelmate",
    "Powerpole",
    "Shinwa",
    "Starlink"
  ],
  "projectManager.git.baseFolders": [
    "/Users/matt/local/documents",
    "/Users/matt/local/dotfiles"
  ],
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.editor.enablePreview": false,
  "editor.accessibilitySupport": "off",

}
