
Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes
    UseKeychain yes

Host pickle-pi
    HostName pickle-pi.local
    User matt
    IdentityFile ~/.ssh/id_ed25519

Host maodou-pi
    HostName maodou-pi.local
    User matt
    IdentityFile ~/.ssh/id_ed25519

# Ping the server to keep the connection alive.
#
Host *
    ServerAliveInterval 120
#
# Allow for multiplexing.
#
Host *
    ControlMaster auto
    ControlPath ~/.ssh/multiplex/%r@%h:%p
    ControlPersist 1
